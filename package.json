{
  "name": "@samhwang/resume-page",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "pnpm run githooks:init && pnpm run panda:codegen",
    "githooks:init": "husky",
    "panda:codegen": "panda codegen",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "lint:fix:unsafe": "oxlint --fix-dangerously . && oxfmt --write .",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@fontsource/mulish": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "@react-hookz/web": "^26.1.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-router-devtools": "^1.167.2",
    "devicon": "^2.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.2",
    "@oxc-node/cli": "^0.1.3",
    "@pandacss/dev": "^2.0.0",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.167.39",
    "@tanstack/router-vite-plugin": "^1.167.41",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.6.0",
    "oxc-transform-react": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-splice": "^0.1.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
