    "@tanstack/react-router-devtools": "^1.167.0",
    "devicon": "^2.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@pandacss/dev": "^1.11.1",
    "@tanstack/router-cli": "^1.167.5",
    "@tanstack/router-plugin": "^1.168.6",
    "@testing-library/dom": "^10.4.1",
